{
  "multipart": [
    {
      "when": { "north": true },
      "apply": { "model": "dreamsdimensions:block/ow_lumina_vines_face" }
    },
    {
      "when": { "east": true },
      "apply": { "model": "dreamsdimensions:block/ow_lumina_vines_face", "y": 90 }
    },
    {
      "when": { "south": true },
      "apply": { "model": "dreamsdimensions:block/ow_lumina_vines_face", "y": 180 }
    },
    {
      "when": { "west": true },
      "apply": { "model": "dreamsdimensions:block/ow_lumina_vines_face", "y": 270 }
    },
    {
      "when": { "up": true },
      "apply": { "model": "dreamsdimensions:block/ow_lumina_vines_face", "x": 270 }
    },
    {
      "when": { "down": true },
      "apply": { "model": "dreamsdimensions:block/ow_lumina_vines_face", "x": 90 }
